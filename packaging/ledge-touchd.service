[Unit]
Description=Ledge touchpad edge-swipe helper
Documentation=https://github.com/GabrielGirardi/ledge
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/python3 %h/.local/lib/ledge/ledge-touchd.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
